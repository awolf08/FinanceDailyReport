# Optional email delivery. Leave blank to only write Markdown files.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_RECIPIENT=your_email@gmail.com

# Report options.
REPORT_TIMEZONE=America/Los_Angeles
REPORT_OUTPUT_DIR=reports
REPORT_NEWS_LIMIT=12
REPORT_STOCK_LIMIT=8
REPORT_WATCHLIST=SPY,QQQ,DIA,IWM,NVDA,AAPL,MSFT,TSLA,AMD,GOOGL,META,AMZN
